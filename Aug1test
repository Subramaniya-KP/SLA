//Second question

//Method overloading happens when methods share a name but have different parameters in one single class. Overloading must have different parameters. It is resolved by complier at compile time.
//Method overriding happens when a child class remakes a parent class method with the exact same name and parameters. Requires two classes linked by inheritance. Also must have same exact parameters. It is resolved by system at run time.

class Present{
	String printing() {
		return "I am  from parent class";
	}
}
class Child extends Present{
	@Override
	String printing() {
		return "I'm from child class";
	}
}
//Overloading example
class calculate {
	
	int add(int a,int b)
	{
		System.out.println("Adding of two numbers: "+(a+b));
		return (a+b);
		
	}
	
	int add(int c,int d, int e)
	{
		System.out.println("Adding of three numbers: "+(c+d+e));
		return (c+d+e);
	}
}


public class MethodOverriding {
	
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Child ch = new Child();
		ch.printing();
		System.out.println("We have overridden the printing method through the child class and the output is "+ch.printing());
		calculate mo = new calculate();
		mo.add(5, 10);
		mo.add(5, 15, 20);
	}

}

