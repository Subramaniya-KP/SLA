//Syntax error occurs when the code violates the grammar rule of the language and it cannot be understood by the system and it will not allow the user to run the program unless resolved.
//For example: system.out.pln("Hello") [This would show a syntax error saying system cannot be resolved since it didn't follow the grammar rule of the language
//where as an exception occurs during the execution of the program eventhough the grammar rule of the language are correct.
//For example: bad input, if for a array length of 4, we try to get output of the 5th element we will see an arrayindexoutofbound exception error.

public class ExampleException {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		try {
			int a=6/0;
			System.out.println(a);
			}
			catch (ArithmeticException e)
			{
			System.out.println("After exception. It is an arithmetic exception");
			}
		try {
			int numbers[] = {3,6,7,8,9};
			System.out.println("Print the 6th element of the array of number:" +numbers[6]);
		}
		catch(ArrayIndexOutOfBoundsException e)
		{
			System.out.println("After exception. It is an arrayindexoutofbounds exception");
			
		}
		
	}

}
