-- Part 2 Inner Join 
-- Display the book title and author name.

SELECT b.title, a.author_name FROM Books b INNER JOIN Authors a ON b.author_id = a.author_id;

SELECT b.title, c.category_name FROM Books b INNER JOIN Categories c ON b.category_id = c.category_id;

SELECT b.title, p.publisher_name FROM Books b INNER JOIN Publishers p ON b.publisher_id = p.publisher_id;

SELECT b.title, a.author_name, c.category_name FROM Books b INNER JOIN Authors a ON b.author_id = a.author_id INNER JOIN Categories c ON b.category_id = c.category_id;

SELECT b.title, a.author_name, c.category_name, p.publisher_name FROM Books b INNER JOIN Authors a ON b.author_id = a.author_id INNER JOIN Categories c ON b.category_id = c.category_id INNER JOIN Publishers p ON b.publisher_id = p.publisher_id;

-- Part 3 Left Join

SELECT b.title, a.author_name FROM Books b LEFT JOIN Authors a ON b.author_id = a.author_id;

SELECT b.title, c.category_name FROM Books b LEFT JOIN Categories c ON b.category_id = c.category_id;

SELECT b.title, p.publisher_name FROM Books b LEFT JOIN Publishers p ON b.publisher_id = p.publisher_id;

SELECT a.author_name, b.title FROM Authors a LEFT JOIN Books b ON a.author_id = b.author_id;

SELECT c.category_name, b.title FROM Categories c LEFT JOIN Books b ON c.category_id = b.category_id;

-- PART 4 RIGHT JOIN 

SELECT b.title, a.author_name FROM Books b RIGHT JOIN Authors a ON b.author_id = a.author_id;

SELECT b.title, c.category_name FROM Books b RIGHT JOIN Categories c ON b.category_id = c.category_id;

SELECT b.title, p.publisher_name FROM Books b RIGHT JOIN Publishers p ON b.publisher_id = p.publisher_id;

SELECT p.publisher_name, b.title FROM Books b RIGHT JOIN Publishers p ON b.publisher_id = p.publisher_id;

SELECT a.author_name, b.title FROM Books b RIGHT JOIN Authors a ON b.author_id = a.author_id;

-- PART 5 FULL OUTER JOIN (USING UNION) 

SELECT b.title, a.author_name FROM Books b LEFT JOIN Authors a ON b.author_id = a.author_id UNION SELECT b.title, a.author_name FROM Books b RIGHT JOIN Authors a ON b.author_id = a.author_id;

SELECT b.title, c.category_name FROM Books b LEFT JOIN Categories c ON b.category_id = c.category_id UNION SELECT b.title, c.category_name FROM Books b RIGHT JOIN Categories c ON b.category_id = c.category_id;

SELECT b.title, p.publisher_name FROM Books b LEFT JOIN Publishers p ON b.publisher_id = p.publisher_id UNION SELECT b.title, p.publisher_name FROM Books b RIGHT JOIN Publishers p ON b.publisher_id = p.publisher_id;

SELECT a.author_name, b.title FROM Authors a LEFT JOIN Books b ON a.author_id = b.author_id UNION SELECT a.author_name, b.title FROM Authors a RIGHT JOIN Books b ON a.author_id = b.author_id;

SELECT c.category_name, b.title FROM Categories c LEFT JOIN Books b ON c.category_id = b.category_id UNION SELECT c.category_name, b.title FROM Categories c RIGHT JOIN Books b ON c.category_id = b.category_id;

-- PART 6 SELF JOIN

SELECT b1.title AS book_title, b2.title AS related_book_title FROM Related_Books rb JOIN Books b1 ON rb.book_id = b1.book_id JOIN Books b2 ON rb.related_book_id = b2.book_id;

SELECT b1.title AS book_title, b2.title AS recommended_book_title FROM Related_Books rb JOIN Books b1 ON rb.book_id = b1.book_id JOIN Books b2 ON rb.related_book_id = b2.book_id;

SELECT b1.title AS book_title FROM Books b1 JOIN Related_Books rb ON b1.book_id = rb.book_id;

SELECT b.title AS book_title FROM Books b LEFT JOIN Related_Books rb ON b.book_id = rb.book_id WHERE rb.book_id IS NULL;

SELECT b1.title AS book_title, b2.title AS related_book_title FROM Books b1 LEFT JOIN Related_Books rb ON b1.book_id = rb.book_id LEFT JOIN Books b2 ON rb.related_book_id = b2.book_id;
