CREATE DATABASE library;
USE LIBRARY;
CREATE TABLE BOOKS(
book_id int primary key auto_increment,
title varchar(100) not null,
author varchar(50) not null,
category varchar(30),
price decimal(8,2),
quantity int,
published_year int
);
