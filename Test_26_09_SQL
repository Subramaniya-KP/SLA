-- 1. Create a database named hospital_db.

create database hospital_db;
use hospital_db;

-- 2. Create a patients table with patient_id, patient_name, age, gender, 
-- phone, and city. Make patient_id automatically generate numbers and uniquely
-- identify each patient. Make patient_name mandatory.

create table patients(
patient_id int auto_increment primary key,
patient_name varchar(50) not null,
age int,
gender char(1),
phone varchar(15),
city varchar(30)
);

-- 3. Add a blood_group column to the patients table.

alter table patients add column blood_group varchar(5);

-- 4. Change the size of the patient_name column to allow up to 100 characters.

alter table patients modify patient_name varchar(100) not null;

